# ── General Application ──────────────────────────────────────────────────────
NODE_ENV=production
API_GATEWAY_URL=https://api.staxless.com
FRONTEND_URL=https://int.staxless.com
COOKIE_DOMAIN=.staxless.com

# ── Container / Service Ports (internal container ports – usually fixed) ─────
# These are the ports services LISTEN on inside their containers
FRONTEND_PORT=3000
AUTH_PORT=8080
USER_PORT=8082
STRIPE_PORT=8083
EMAIL_PORT=8084

# ── Database Ports (used when building connection strings or for local dev) ──
MONGO_PORT=27017                 # ← MongoDB default port (not used in current compose)


# ── Cloudflare Tunnel (for secure public exposure without open ports) ───────
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...very-long-base64-token-here...

# ── OAuth2 / Social Login Providers ──────────────────────────────────────────
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ── Payment – Stripe ─────────────────────────────────────────────────────────
STRIPE_PRIVATE_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email – Mailgun ──────────────────────────────────────────────────────────
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=...           # (currently hardcoded in compose)
# MAILGUN_FROM_NAME=...
# MAILGUN_FROM_EMAIL=...

# ── Database Connection ──────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_NAME=db

