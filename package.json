{
  "name": "staxless",
  "version": "2.25.10",
  "private": true,
  "description": "SaaS boilerplate with Next.js frontend, Node.js microservices, and Kong API gateway",
  "license": "ISC",
  "scripts": {
    "docker:build-push": "bash ./.scripts/docker-build-push.sh",
    "install:microservices": "bash .scripts/development/install-services.sh",
    "dev:start": "docker compose -f ./docker/compose/docker-compose.dev.yml up --build",
    "dev:up": "docker compose -f ./docker/compose/docker-compose.dev.yml up",
    "dev:down": "docker compose -f ./docker/compose/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f ./docker/compose/docker-compose.dev.yml logs -f",
    "prod:deploy": "docker stack deploy -c ./docker/compose/prod.yml staxless",
    "prod:remove": "docker stack rm staxless",
    "prod:status": "docker stack ps staxless",
    "prod:logs": "docker service logs -f staxless",
    "lint": "npx ultracite lint",
    "format": "npx ultracite format",
    "test": "jest",
    "release": "semantic-release",
    "lint:fix": "npx ultracite fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tailwindcss/postcss": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^29.7.0",
    "postcss": "^8.5.5",
    "semantic-release": "^24.1.3",
    "tailwindcss": "^4.1.10",
    "ultracite": "^5.6.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": "npx ultracite fix"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@staxless/cli": "^2.0.1"
  }
}
