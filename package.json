{
  "name": "staxless",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "docker:build-push": "bash ./scripts/docker-build-push.sh",

    "staxless-dev-build": "docker compose -f ./config/docker-compose.dev.yml up --build",
    "staxless-dev-up": "docker compose -f ./config/docker-compose.dev.yml up",
    "staxless-dev-down": "docker compose -f ./config/docker-compose.dev.yml down",
    "staxless-dev-logs": "docker compose -f ./config/docker-compose.dev.yml logs -f",

    "staxless-prod-deploy": "docker stack deploy -c ./config/docker-compose.prod.yml staxless",
    "staxless-prod-rm": "docker stack rm staxless",
    "staxless-prod-ps": "docker stack ps staxless",
    "staxless-prod-logs": "docker service logs -f staxless",

    "dev:build": "npm run staxless-dev-build",
    "dev:up": "npm run staxless-dev-up",
    "dev:down": "npm run staxless-dev-down",
    "dev:logs": "npm run staxless-dev-logs",

    "prod:deploy": "npm run staxless-prod-deploy",
    "prod:rm": "npm run staxless-prod-rm",
    "prod:ps": "npm run staxless-prod-ps",
    "prod:logs": "npm run staxless-prod-logs",

    "lint": "npx ultracite check",
    "format": "npx ultracite fix",
    "test": "jest",
    "release": "semantic-release"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tailwindcss/postcss": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^29.7.0",
    "postcss": "^8.5.5",
    "semantic-release": "^24.1.3",
    "tailwindcss": "^4.1.10",
    "ultracite": "5.0.26"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": "npx ultracite fix"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
