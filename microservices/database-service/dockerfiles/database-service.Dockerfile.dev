# Use the official Node.js image as the base image
FROM node:latest

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and package-lock.json to the working directory
COPY ../package*.json ./

# Install dependencies using npm
RUN npm install express nodemon dotenv @supabase/supabase-js bcrypt axios

# Copy the rest of the application code to the working directory
COPY ../ .

# Expose the port that the Stripe service will listen on
EXPOSE 8002

# Command to run the Stripe service when the container starts
CMD ["npm", "start"]
